{
  "rules": {
    "description": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      ".validate": "newData.isString() && newData.val().length <= 2000"
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')",
        ".validate": "newData.hasChildren(['name', 'total'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 30 && (data.val() === newData.val() || root.child('nlock').child($uid).val() !== true || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() <= (data.exists() ? data.val() : 0) + 500 || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')"
        },
        "d": {
          "$day": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() <= (data.exists() ? data.val() : 0) + 500 || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')"
          }
        },
        "w": {
          "$week": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() <= (data.exists() ? data.val() : 0) + 500 || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')"
          }
        },
        "m": {
          "$month": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() <= (data.exists() ? data.val() : 0) + 500 || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')"
          }
        },
        "av": {
          ".validate": "newData.isString() && newData.val().length <= 8 && (newData.val() !== '👑' || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2' || root.child('prem').child($uid).exists())"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "font": {
          ".validate": "newData.isString() && newData.val().length <= 12 && (!newData.val().matches(/^(gothic|elegant|block3d|fire|candy|honk)$/) || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2' || root.child('prem').child($uid).exists())"
        },
        "fx": {
          ".validate": "newData.isString() && newData.val().length <= 10 && (!newData.val().matches(/^(rainbow|shimmer|glow|fire|rwave|type)$/) || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2' || root.child('prem').child($uid).exists())"
        },
        "bd": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && ((!data.exists() && newData.child('pid').val() === auth.uid && root.child('players').child(auth.uid).child('total').val() >= 100) || (!newData.exists() && (data.child('pid').val() === auth.uid || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'))) || (auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2' && data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['pid', 'text', 't'])",
        "pid": {
          ".validate": "newData.isString()"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "re": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "rx": {
          "$e": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true && ($e === 'like' || $e === 'laugh' || $e === 'love' || $e === 'wow')"
            }
          }
        },
        "ed": {
          ".validate": "newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "challenge": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      ".validate": "newData.hasChildren(['target'])",
      "target": {
        ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000"
      },
      "title": {
        ".validate": "newData.isString() && newData.val().length <= 60"
      },
      "$other": {
        ".validate": false
      }
    },
    "duels": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid && root.child('players').child(auth.uid).exists()) || (!newData.exists() && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')))",
        ".validate": "newData.hasChildren(['from', 'to', 'qs', 't'])",
        "from": {
          ".validate": "newData.isString()"
        },
        "to": {
          ".validate": "newData.isString() && newData.val() !== newData.parent().child('from').val() && root.child('players').child(newData.val()).exists()"
        },
        "qs": {
          "$i": {
            ".validate": "newData.hasChildren(['k', 'd']) && $i.matches(/^[0-9]$/)",
            "k": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "d": {
              ".validate": "newData.val() === 'el' || newData.val() === 'le'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "res": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && (data.parent().parent().child('from').val() === $uid || data.parent().parent().child('to').val() === $uid)",
            ".validate": "newData.hasChildren(['s', 'ms'])",
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "names": {
      ".read": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      "$uid": {
        "$k": {
          ".write": "auth != null && !data.exists() && (auth.uid === $uid || auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2')",
          ".validate": "newData.hasChildren(['n', 't', 'by']) && $k.length <= 30",
          "n": {
            ".validate": "newData.isString() && newData.val() === root.child('players').child($uid).child('name').val()"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "by": {
            ".validate": "(newData.val() === 'admin' && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2') || ((newData.val() === 'self' || newData.val() === 'join') && auth.uid === $uid)"
          },
          "p": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "nlock": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
        ".validate": "newData.val() === true"
      }
    },
    "mute": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
        ".validate": "newData.val() === true"
      }
    },
    "lbhide": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
        ".validate": "newData.val() === true"
      }
    },
    "codes": {
      ".read": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      ".write": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      "$c": {
        ".read": "auth != null",
        ".validate": "newData.hasChildren(['left']) && $c.matches(/^[a-z0-9 ]{1,40}$/)",
        "left": {
          ".write": "auth != null && data.isNumber() && data.val() > 0 && newData.val() === data.val() - 1 && newData.parent().parent().parent().child('prem').child(auth.uid).child('c').val() === $c && !root.child('prem').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "prem": {
      ".read": "auth != null && auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === 'F8AyOfnDz4RASWZnH6J09EmcAtv2' || (auth.uid === $uid && !data.exists() && newData.child('c').isString() && root.child('codes').child(newData.child('c').val()).child('left').val() > 0 && newData.parent().parent().child('codes').child(newData.child('c').val()).child('left').val() === root.child('codes').child(newData.child('c').val()).child('left').val() - 1))",
        ".validate": "newData.hasChildren(['c', 't'])",
        "c": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
