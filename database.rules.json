{
  "rules": {
    "description": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isString() && newData.val().length <= 2000"
    },
    "players": {
      ".read": true,
      "$pid": {
        ".write": "$pid.length <= 24",
        ".validate": "newData.hasChildren(['name', 'total'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 500" },
        "d": { "$day":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 500" } },
        "w": { "$week":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 500" } },
        "m": { "$month": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 500" } },
        "$other": { ".validate": false }
      }
    },
    "chat": {
      ".read": true,
      "$msg": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['pid', 'text', 't']) && root.child('players').child(newData.child('pid').val()).exists()",
        "pid": { ".validate": "newData.isString()" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
        "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}
